# Copy to .env and fill in. The real .env is git-ignored and managed locally.

# MLflow tracking. Leave MLFLOW_TRACKING_URI empty (or unset) to run the pipeline
# without tracking.
MLFLOW_TRACKING_URI=https://your-mlflow-server

# The server sits behind Keycloak: a service-account client with the mlflow "access" role.
# Leave KEYCLOAK_CLIENT_ID empty for a server without Keycloak.
KEYCLOAK_TOKEN_URL=https://auth.wyrmling.xyz/realms/homelab/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret

# Basic auth instead, for a server without Keycloak (read by the MLflow client itself).
# Must stay unset together with KEYCLOAK_CLIENT_ID.
# MLFLOW_TRACKING_USERNAME=your-username
# MLFLOW_TRACKING_PASSWORD=your-password

# Every run of this project is grouped under this MLflow experiment.
MLFLOW_EXPERIMENT_NAME=cdcr_lexical_diversity_pairwise_scoring

# Silences the MLflow "agent hint" banner printed on every import.
MLFLOW_DISABLE_AGENT_HINT=1
